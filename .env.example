# Copy to .env. Validated by src/config/env.ts at boot — a bad value fails fast.
# In production nothing pointing at another system defaults: DATABASE_URL, JWT_SECRET,
# REDIS_URL and CORS_ORIGINS must be set or the process refuses to start and names them.
# ─── ENVIRONMENT ────────────────────────────────────────────────────────────────
# Local Development
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Production Example
# NODE_ENV=production
# CORS_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com

PORT=4000
API_PREFIX=api
# ─── DATABASE ───────────────────────────────────────────────────────────────────
# Local Development (Docker Compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/enterprise
DATABASE_SSL=false

# Production (AWS RDS PostgreSQL Example)
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@your-rds-endpoint.amazonaws.com:5432/enterprise_db
# DATABASE_SSL=true
# DATABASE_SSL_CA_PATH=/app/certs/rds-combined-ca-bundle.pem

DATABASE_LOGGING=false
DATABASE_POOL_SIZE=10

# ─── AUTH ───────────────────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-long-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ─── REDIS ──────────────────────────────────────────────────────────────────────
# Local Development (Docker Compose)
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# Production (AWS ElastiCache Redis Example)
# REDIS_URL=rediss://:AUTH_TOKEN@your-elasticache-endpoint.cache.amazonaws.com:6379
# REDIS_TLS=true

REDIS_KEY_PREFIX=app:

# ─── AWS S3 ─────────────────────────────────────────────────────────────────────
AWS_S3_BUCKET=enterprice-bucket
AWS_S3_REGION=ap-south-1
# Leave blank to use EC2/ECS task roles in production
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# CloudFront domain or custom domain (optional)
AWS_S3_PUBLIC_URL=https://d39y49k5ezx4g2.cloudfront.net

SERVICE_NAME=enterprise-api
# Defaults to the package.json version; set it to log a git SHA or image tag instead.
# SERVICE_VERSION=
LOG_LEVEL=debug
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Required by `pnpm seed` — it refuses to run without both, and checks the password
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
